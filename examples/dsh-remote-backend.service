[Unit]
Description=dsh-remote server backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh-remote
Group=dsh-remote
WorkingDirectory=/opt/dsh-remote-backend
Environment=NODE_ENV=production
Environment=DSH_RELAY_CONFIG=/var/lib/dsh-remote/server.json
ExecStart=/usr/bin/node /opt/dsh-remote-backend/src/main.mjs
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=dsh-remote
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
