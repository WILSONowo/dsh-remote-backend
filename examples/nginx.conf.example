# Add the map in nginx's http context. Use a dedicated server block.
map $http_upgrade $dsh_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name example.com;
    ssl_certificate /etc/ssl/dsh/fullchain.pem;
    ssl_certificate_key /etc/ssl/dsh/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Avoid logging addresses, pairing URLs, request headers or bodies.
    access_log off;
    error_log /dev/null;
    client_max_body_size 64m;
    client_body_timeout 60s;

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dsh_connection_upgrade;
        # This example has exactly one trusted proxy. Discard user-supplied XFF.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }
}
